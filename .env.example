# ═══════════════════════════════════════════════════════════════════════════
#  YOUR CUSTOM WHATSAPP BOT — ENVIRONMENT CONFIGURATION
#  Copy this file to `.env` and fill in your real values, OR set the same
#  variables in your Railway/Render dashboard.
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. BOT IDENTITY ─────────────────────────────────────────────────────────
# The display name printed in menus, footers, and status messages.
# Tip: After first boot you can also change this at runtime with `.setbotname <name>`
BOT_NAME="KLAUS-MD"

# Your WhatsApp number in international format, no "+", no spaces.
# Example for Kenya: 254712345678  |  Nigeria: 2348012345678  |  India: 919876543210
# This number becomes the bot owner and is granted admin/sudo privileges.
OWNER_NUMBER=254711815459

# ── 2. COMMAND BEHAVIOUR ───────────────────────────────────────────────────
# The character that prefixes every command. "." means `.ping`, `.menu`, etc.
# Alternatives: ! ? / +
BOT_PREFIX=.

# Operating mode. One of:
#   public  — anyone in any chat can use commands (default)
#   private — only the owner number can use commands
#   group   — commands only work in group chats
#   solo    — commands only work in DMs with the owner
#   sudo    — owner + a list of trusted sudo numbers can use commands
#   super   — owner + sudo + whitelisted numbers
#   buttons — interactive button menu mode
#   channel — WhatsApp channel broadcast mode
BOT_MODE=public

# Timezone for menu timestamps and scheduled messages.
# Find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
BOT_TIMEZONE=Africa/Nairobi

# ── 3. WHATSAPP SESSION (REQUIRED) ──────────────────────────────────────────
# Your WhatsApp session ID. Must begin with `KLAUS MD:` (or legacy `KLAUS MD:`).
#
# HOW TO GET ONE:
#   1. Leave this EMPTY on first boot.
#   2. Run `npm start` (or deploy to Railway/Render).
#   3. The bot prints a pairing menu — choose Option 1 and enter your phone.
#   4. You'll get an 8-character pairing code (e.g. AB12-CD34).
#   5. Open WhatsApp on your phone → Settings → Linked Devices → Link with
#      phone number → enter the code.
#   6. The bot AUTO-PRINTS a banner like:
#        SESSION_ID=KLAUS MD:eyJrZXlzIjp7...base64...
#      and AUTO-WRITES it to .env (quoted, since KLAUS MD: has a space).
#   7. On Railway/Render, paste that string into the SESSION_ID env var in
#      the dashboard. On local, the bot already wrote it to this file.
SESSION_ID=

# ── 4. OPTIONAL INTEGRATIONS (LEFT EMPTY = DISABLED) ───────────────────────
# PostgreSQL connection string for persistent cross-deploy storage.
# Format: postgres://user:password@host:5432/dbname?sslmode=require
# Leave blank to use local SQLite (data is wiped on redeploy).
DATABASE_URL=

# Pterodactyl panel — only if you want cpanel/* commands to work.
PTERODACTYL_KEY=
PTERODACTYL_URL=

# Paystack — only if you want M-Pesa STK push payment commands.
PAYSTACK_KEY=

# ── 5. INTERNAL (DO NOT TOUCH) ──────────────────────────────────────────────
# Wolf API key — pre-baked by upstream. Leave as-is unless you have a new one.
XWOLF_API_KEY=wxa_u_xwk7sch6xj
