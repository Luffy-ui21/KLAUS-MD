# KLAUS-MD — Premium Multi-User WhatsApp Bot
#
# ALL of these are OPTIONAL — the bot works out of the box on Render with zero
# configuration. Every user who pairs their WhatsApp becomes the owner of their
# own bot instance (multi-user).
#
# You CAN override the defaults below if you want to lock the bot name / owner.

# ─────────────────────────────────────────────
# 🤖 BOT IDENTITY
# ─────────────────────────────────────────────
# The bot name shown in menus, welcome messages, banners, etc.
BOT_NAME=KLAUS-MD

# 👑 GLOBAL OWNER NUMBER (used for notifications + cross-session admin).
# Format: country code + number, digits only. No +, no spaces, no leading 0.
# When a new user pairs, this number receives a notification.
# In private mode, this number can use commands on ANY session.
OWNER_NUMBER=254711815459

# ─────────────────────────────────────────────
# 📡 PAIRING SERVER
# ─────────────────────────────────────────────
# Port (Render auto-sets PORT; Pterodactyl auto-sets SERVER_PORT)
# PORT=3001

# Default command prefix (each user can override with .setprefix)
# PREFIX=.

# How long (seconds) a pairing code stays valid
# PAIRING_CODE_TTL=90

# Idle session disconnect timeout (hours) — bot disconnects if no messages
# IDLE_TIMEOUT_HOURS=6

# Optional site password (visitors must enter this to pair)
# SITE_PASSWORD=

# ─────────────────────────────────────────────
# 🛡️ ANTI / AUTOMATION
# ─────────────────────────────────────────────
# Restore deleted messages in groups
# ANTI_DELETE=true

# Auto-view status updates
# AUTO_READ_STATUS=true

# Auto-react ❤️ to status updates (requires AUTO_READ_STATUS=true)
# AUTO_REACT_STATUS=true

# ─────────────────────────────────────────────
# 🤖 AI (optional — for .quote, .joke auto-gen, etc.)
# ─────────────────────────────────────────────
# Get a free key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# ─────────────────────────────────────────────
# 💾 DATABASE
# ─────────────────────────────────────────────
# SQLite by default. Use postgres:// URL for production.
# DATABASE_URL=file:./prisma/klaus-md.db

# ─────────────────────────────────────────────
# 👥 SUPPORT GROUP (optional auto-join)
# ─────────────────────────────────────────────
# Invite code (without https://chat.whatsapp.com/) — bot auto-joins on connect
# SUPPORT_GROUP_INVITE=
